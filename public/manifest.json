{
  "manifest_version": 3,
  "name": "video-parallel",
  "version": "0.1.15",
  "minimum_chrome_version": "116",
  "description": "Turn YouTube captions into AI-generated chapter summaries synced to playback.",
  "permissions": ["sidePanel", "storage", "tabs", "scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open video-parallel"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Option+Shift+9"
      },
      "description": "打开或关闭当前视频的概要侧边栏"
    },
    "process-video": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "打开侧边栏并生成当前视频的章节概要"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
